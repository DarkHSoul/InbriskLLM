# ai_shell.py — Tek terminalde calisan, tool-call destekli yerel AI agent.
# Kalici bir PowerShell surecine baglanir; LLM (Ollama) komut uretir,
# komut ayni shell'de icra edilir, cikti modele geri beslenir.
#
# Kullanim:  python ai_shell.py [--model qwen3:4b] [--timeout 60]

import argparse
import json
import msvcrt
import os
import queue
import base64
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.request

MARK = "__AI_SHELL_DONE_9f2c__"
OLLAMA_URL = "http://localhost:11434/api/chat"
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SESSIONS_DIR = os.path.join(BASE_DIR, "sessions")
LOGS_DIR = os.path.join(BASE_DIR, "logs")


class Logger:
    """Oturum olaylarini JSONL olarak diske yazar (her satir bir olay)."""

    def __init__(self, logdir):
        os.makedirs(logdir, exist_ok=True)
        self.path = os.path.join(
            logdir, time.strftime("session_%Y%m%d-%H%M%S") + ".jsonl")
        self.f = open(self.path, "a", encoding="utf-8")

    def event(self, kind, **data):
        rec = {"ts": time.strftime("%Y-%m-%d %H:%M:%S"),
               "epoch": time.time(), "type": kind}
        rec.update(data)
        self.f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        self.f.flush()

    def close(self):
        try:
            self.f.close()
        except Exception:
            pass

